# ==============================================================================
# LAN Booking API - Production Environment Variables Template
# ==============================================================================
# Copy this file to your production server as .env
# Replace all placeholder values with your actual production values
# ==============================================================================

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production

# Azure SQL Database Connection
DB_HOST=your-database-server.database.windows.net
DB_NAME=your-database-name
DB_USER=your-db-username
DB_PASSWORD=your-strong-db-password

# SendGrid Email Service
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SG_BOOKING_TEMPLATE_ID=your-booking-template-id
SG_INVITE_TEMPLATE_ID=your-invite-template-id

# Legacy Invite Secret
INVITE_SECRET=your-random-invite-secret

# ------------------------------------------------------------------------------
# Keycloak Integration (for API service)
# ------------------------------------------------------------------------------
# Base URL - Use HTTPS in production!
KEYCLOAK_BASE_URL=https://auth.yourdomain.com
KEYCLOAK_REALM=lanbooking
KEYCLOAK_CLIENT_ID=lanbooking-api
KEYCLOAK_AUDIENCE=your-keycloak-audience
KEYCLOAK_REQUIRED_ROLE=intra-admin

# ------------------------------------------------------------------------------
# Keycloak Server Configuration
# ------------------------------------------------------------------------------
# Keycloak Mode: "dev" for development, "production" for production (default)
# In dev mode: HTTP enabled, strict hostname disabled, uses start-dev
# In production mode: optimized build, respects all security settings
KEYCLOAK_MODE=production

# Admin Credentials - CHANGE THESE IN PRODUCTION!
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-to-strong-password

# Keycloak Database Configuration
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-this-to-strong-db-password
KEYCLOAK_DB_NAME=keycloak

# Keycloak Hostname and Security Settings
# IMPORTANT: Set this to your production Keycloak domain (what users see)
KEYCLOAK_HOSTNAME=auth.yourdomain.com
KEYCLOAK_HOSTNAME_STRICT=true
KEYCLOAK_HOSTNAME_STRICT_HTTPS=true

# Keycloak HTTP/HTTPS Configuration
# When behind a reverse proxy (HTTPS termination at proxy):
# - Set HTTP_ENABLED=true (Keycloak runs HTTP internally, proxy handles HTTPS)
# - HTTPS_PORT is not needed (remove from docker-compose if present)
# When Keycloak handles HTTPS directly:
# - Set HTTP_ENABLED=false and configure SSL certificates
KEYCLOAK_HTTP_ENABLED=true
KEYCLOAK_HTTP_PORT=8080

# Keycloak Realm Import Directory
# Set to './keycloak-production' for production realm configuration
# Leave unset or set to './keycloak' for development realm configuration
# IMPORTANT: Before deploying, copy keycloak-production/lanbooking-realm.json.template
# to keycloak-production/lanbooking-realm.json and configure with your production values
KEYCLOAK_REALM_DIR=./keycloak-production

