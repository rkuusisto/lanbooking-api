FROM quay.io/keycloak/keycloak:24.0.5 AS builder

# Build the optimized Keycloak distribution with PostgreSQL database driver
# This needs to be done at build time for production optimized mode
WORKDIR /opt/keycloak

# Build with PostgreSQL database driver
# This adds the PostgreSQL driver to the optimized build
RUN /opt/keycloak/bin/kc.sh build --db=postgres

# Production image
FROM quay.io/keycloak/keycloak:24.0.5

WORKDIR /opt/keycloak

# Copy the optimized build from builder
# The build command creates optimized files in the Keycloak directory
# We copy the entire directory to preserve all optimized artifacts including the database driver
COPY --from=builder --chown=keycloak:keycloak /opt/keycloak/ /opt/keycloak/

# Copy entrypoint script (will be overridden by volume mount if provided in docker-compose)
COPY keycloak-entrypoint.sh /opt/keycloak/entrypoint.sh
RUN chmod +x /opt/keycloak/entrypoint.sh

ENTRYPOINT ["/opt/keycloak/entrypoint.sh"]

